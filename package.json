{
  "name": "cambiran-pickleball-store",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "pnpm run db:migrate",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "db:migrate": "pnpm --filter @dtc/backend exec medusa db:migrate",
    "storefront:configure": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/configure-storefront.ts",
    "railway:build:backend": "pnpm --filter @dtc/backend run build",
    "railway:start:backend": "node scripts/start-medusa.mjs",
    "railway:migrate": "cd apps/backend/.medusa/server && ../../node_modules/.bin/medusa db:migrate",
    "railway:build:storefront": "pnpm --filter @dtc/storefront run build",
    "railway:start:storefront": "pnpm --filter @dtc/storefront run start"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.20.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
